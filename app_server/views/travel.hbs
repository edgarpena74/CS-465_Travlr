<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Dive Sites - Bhaccasyoniztas Beach Resort Website Template</title>
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{!-- Replaced the header div with the hbs instruction tag --}}
			{{> header }}
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>Travel</h1>
							<ul id="sites">
								{{!-- Handlebars loop, iterates over trips object passed to the templete --}}
								{{#each trips}}
								<li>
									<a href="/api/trips/{{trips.code}}">
										<img src = "public/images/{{this.images}}" alt = "Img">
									</a>
									<h2>
										<a href="/travel">
										{{this.name}}
										</a>
									</h2>
									{{{this.description}}}

								</li>
								{{/each}}

							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer }}
	</div>
</body>
</html>